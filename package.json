{
  "name": "mine-note",
  "private": true,
  "description": "A local-first notes app with a searchable connection graph",
  "author": "Mine",
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c teal,copper \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "build:desktop": "npm run build && node scripts/build-electron.mjs",
    "start": "tsx server/index.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "seed": "tsx server/seed.ts",
    "test": "tsx --test server/*.test.ts src/lib/*.test.ts",
    "electron:dev": "node scripts/build-electron.mjs && concurrently -k -n web,electron -c copper,cyan \"vite\" \"node scripts/electron-dev.mjs\"",
    "electron:build:mac": "npm run build:desktop && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64 --publish never",
    "electron:build:win": "npm run build:desktop && electron-builder --win nsis --x64 --publish never",
    "docker:build:win": "docker compose run --rm win",
    "docker:build:mac": "docker compose run --rm --build mac"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "lucide-react": "^1.31.0",
    "marked": "^18.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "sqlite-vec": "^0.1.9",
    "uuid": "^14.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vite": "^8.2.1"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true,
    "@esbuild/darwin-arm64": true,
    "@esbuild/darwin-x64": true,
    "@esbuild/linux-arm64": true,
    "@esbuild/linux-x64": true,
    "@esbuild/win32-arm64": true,
    "@esbuild/win32-ia32": true,
    "@esbuild/win32-x64": true,
    "fsevents": true,
    "protobufjs": true,
    "sharp": true,
    "@img/sharp-darwin-arm64": true,
    "@img/sharp-darwin-x64": true,
    "@img/sharp-linux-arm64": true,
    "@img/sharp-linux-x64": true,
    "@img/sharp-win32-arm64": true,
    "@img/sharp-win32-ia32": true,
    "@img/sharp-win32-x64": true,
    "@img/sharp-libvips-darwin-arm64": true,
    "@img/sharp-libvips-darwin-x64": true,
    "@img/sharp-libvips-linux-arm64": true,
    "@img/sharp-libvips-linux-x64": true,
    "onnxruntime-node": true
  }
}
